# ─────────────────────────────────────────────────
# TopFlowNG — Environment Variables
# Copy this file to .env and fill in your real keys
# NEVER commit .env to git
# All values below are NON-SECRET examples / defaults.
# ─────────────────────────────────────────────────

PORT=3000
NODE_ENV=development

# ── App ──────────────────────────────────────────
# Your public origin — used for CORS + payment callbacks
APP_URL=https://topflowng.com
# Trust Railway's load balancer for accurate rate limiting (1 = trust)
TRUST_PROXY=1
# Max JSON request body size
BODY_LIMIT=10kb

# ── Clubkonnect ──────────────────────────────────
# Get these from your Clubkonnect dashboard → Developer's API
CLUBKONNECT_USER_ID=your_clubkonnect_phone_number
CLUBKONNECT_API_KEY=your_clubkonnect_api_key
# Whitelist your server IP in Clubkonnect dashboard first!
CLUBKONNECT_BASE_URL=https://www.clubkonnect.com
# Provider transaction-status endpoint (override to point at a test stub)
CLUBKONNECT_QUERY_URL=https://www.nellobytesystems.com/APIQuery.asp
# Individual provider endpoints (override for tests / if Clubkonnect changes them)
CLUBKONNECT_AIRTIME_URL=https://www.nellobytesystems.com/APIAirtimeV1.asp
CLUBKONNECT_DATA_URL=https://www.nellobytesystems.com/APIDataBundleV1.asp
CLUBKONNECT_CABLE_URL=https://www.nellobytesystems.com/APICableTVV1.asp
CLUBKONNECT_ELECTRICITY_URL=https://www.nellobytesystems.com/APIElectricityV1.asp
CLUBKONNECT_EXAM_URL=https://www.nellobytesystems.com/APIExamPins.asp
CLUBKONNECT_RECHARGE_URL=https://www.nellobytesystems.com/APIRechargeCard.asp
# Provider request timeout (ms) and max single purchase amount (naira)
CLUBKONNECT_TIMEOUT_MS=30000
MAX_PURCHASE_AMOUNT=1000000

# ── Email delivery (Resend) ──────────────────────
# Create a sending-only key restricted to mail.topflowng.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="TopFlowNG <noreply@mail.topflowng.com>"
RESEND_URL=https://api.resend.com/emails
RESEND_TIMEOUT_MS=15000

# ── Paystack ─────────────────────────────────────
# Get from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxx
# API base URL (override for tests)
PAYSTACK_API_BASE_URL=https://api.paystack.co
PAYSTACK_TIMEOUT_MS=30000
# Optional: Webhook signing secret Paystack sends in x-paystack-signature
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# ── App secrets ──────────────────────────────────
# A long random string for signing internal tokens
JWT_SECRET=change_this_to_a_long_random_string_64chars
JWT_EXPIRES_IN=7d

# ── Rate limiting ────────────────────────────────
# Auth routes (register/login/reset): window + max requests
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=10
# General API routes: window + max requests
API_RATE_WINDOW_MS=60000
API_RATE_MAX=60

# ── Observability ────────────────────────────────
# Structured log level: debug | info | warn | error
LOG_LEVEL=info
# Sentry (optional). Empty = disabled.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2