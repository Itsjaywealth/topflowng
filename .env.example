# ─────────────────────────────────────────────────────────────────────────────
# TopFlowNG — Environment Variables
#
# Copy this file to `.env` and fill in real values for local runs. On the
# production host the same variables must be set by the platform's config
# system (NOT in a committed file).
#
#   • NEVER commit `.env` or any real secret to git.
#   • All values below are NON-SECRET examples / placeholders.
#   • In production the app FAILS FAST at startup if any REQUIRED variable is
#     missing (it reports only the variable NAMES, never their values).
#   • Keys labelled OPTIONAL only degrade the associated feature when absent.
# ─────────────────────────────────────────────────────────────────────────────

# ── Node ─────────────────────────────────────────────────────────────────────
# development | test | production. Tests set this themselves.
NODE_ENV=development
PORT=3000

# ── Build / version metadata (OPTIONAL, non-secret) ──────────────────────────
# Which Git commit is running, surfaced read-only at /api/version and /api/ready
# for operator commit-parity checks. Railway injects RAILWAY_GIT_COMMIT_SHA
# automatically on deploys; the others are fallbacks for other hosts.
# Falls back to "unknown" when none is set. Never secrets.
RAILWAY_GIT_COMMIT_SHA=
APP_COMMIT=
GIT_SHA=
APP_VERSION=1.0.0

# ── Multi-provider readiness (OPTIONAL, all OFF by default) ──────────────────
# Server-controlled provider status overrides. Unfinished providers stay
# BLOCKED_EXTERNAL until approved + credentialed. Do NOT set these to active
# without a legitimately approved provider.
BITREFILL_STATUS=BLOCKED_EXTERNAL
DTONE_STATUS=BLOCKED_EXTERNAL
# Customer-facing category flags — keep OFF until provider is certified.
GIFT_CARDS_ENABLED=false
ESIMS_ENABLED=false
INTERNATIONAL_AIRTIME_ENABLED=false
INTERNATIONAL_DATA_ENABLED=false
DIGITAL_VOUCHERS_ENABLED=false
# Server-controlled purchase/funding safety switches (default = enabled).
# Setting either to false gates NEW purchase/funding initiation only.
PURCHASES_ENABLED=true
FUNDING_ENABLED=true
# Placeholder-only future provider credentials. NEVER put real secrets here or
# in any committed file. Populate only on the production host when approved.
BITREFILL_API_ID=
BITREFILL_API_SECRET=
DTONE_API_KEY=

# ── REQUIRED in production ───────────────────────────────────────────────────
# Postgres connection. Use sslmode=require on managed hosts with TLS
# (Railway/Render/Heroku supply this in DATABASE_URL already). For a local or
# TLS-less database explicitly append ?sslmode=disable.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/topflowng?sslmode=require
# Long random string (>=64 chars) used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_of_at_least_64_chars
# Canonical public origin — CORS allow-list, payment callbacks, reset links.
APP_URL=https://topflowng.com
# Official customer-facing support email. Reply-To on transactional emails.
SUPPORT_EMAIL=hello@topflowng.com
# SMTP delivery (verified: hello@topflowng.com mailbox is on Titan Email —
# MX mx1/mx2.titan.email, SMTP smtp.titan.email). When SMTP_HOST + SMTP_USER +
# SMTP_PASSWORD are set, transactional email is sent over SMTP with Resend/Brevo
# as fallback. SMTP_FROM defaults to "TopFlowNG <hello@topflowng.com>".
# SMTP_SECURE=1 means implicit TLS on port 465; set 0 for STARTTLS on 587.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=1
SMTP_FROM="TopFlowNG <hello@topflowng.com>"
# VTPass (VTU provider) credentials — from your VTpass dashboard
# (Settings → API Keys). Replaces the legacy Clubkonnect/Nellobyte API.
#
# Two auth modes are supported (VTPASS_AUTH_TYPE):
#   basic  — uses VTPASS_USERNAME + VTPASS_PASSWORD (HTTP Basic auth). This
#            bypasses the API IP whitelist, so it is the RECOMMENDED mode.
#   apikey — uses the API key headers below (requires API IP whitelisting).
#
# Basic auth mode (recommended, live production config):
VTPASS_AUTH_TYPE=basic
VTPASS_USERNAME=your_vtpass_email
VTPASS_PASSWORD=your_vtpass_password
#
# API-key auth mode (alternative, requires IP whitelisting via VTpass support):
VTPASS_API_KEY=your_vtpass_api_key
VTPASS_SECRET_KEY=your_vtpass_secret_key
VTPASS_PUBLIC_KEY=your_vtpass_public_key
# Paystack secret key — from dashboard.paystack.com → Settings → Developers.
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OPTIONAL in production (feature degraded if absent) ──────────────────────
# Webhook signing secret from Paystack. When absent the Paystack secret key is
# used for HMAC verification.
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret
# Resend API key for email delivery (password resets, purchase receipts).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OpenRouter key for the read-only AI assistant.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sentry DSN. Empty = Sentry disabled entirely (no initialisation, no traffic).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# ── App tuning ────────────────────────────────────────────────────────────────
# Trust the TLS-terminating reverse proxy for accurate rate limiting (1 = trust).
# Set 0 ONLY if this app is directly internet-facing with no proxy.
TRUST_PROXY=1
# Max JSON request body size.
BODY_LIMIT=10kb
# JWT lifetime (e.g. 7d, 12h).
JWT_EXPIRES_IN=7d

# ── Markup / service fees ──────────────────────────────────────────────────────
# Airtime: percentage markup (default 0.02 = 2%) with a minimum naira floor.
# Electricity: flat service fee added to every token purchase.
AIRTIME_MARKUP_RATE=0.02
AIRTIME_MIN_MARKUP=2
ELECTRICITY_SERVICE_FEE=100

# ── Rate limiting ────────────────────────────────────────────────────────────
# Auth routes (register/login/reset): window + max requests.
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=10
# General API routes: window + max requests.
API_RATE_WINDOW_MS=60000
API_RATE_MAX=60

# ── VTPass endpoints (override only for tests / provider changes) ────────────
VTPASS_BASE_URL=https://vtpass.com/api
VTPASS_TIMEOUT_MS=30000
MAX_PURCHASE_AMOUNT=1000000
# Optional JSON blob overriding the built-in product→service/variation map.
# Shape: {"MTN1GB":{"serviceID":"mtn-data","variation":"mtn-sme-1gb"}}
VTPASS_PRODUCT_MAP=

# ── Email delivery (Resend) ──────────────────────────────────────────────────
RESEND_FROM="TopFlowNG <noreply@mail.topflowng.com>"
RESEND_URL=https://api.resend.com/emails
RESEND_TIMEOUT_MS=15000

# ── Internal API key (n8n / automation) ───────────────────────────────────────
# Shared secret for machine-to-machine endpoints (/api/internal/*). n8n sends
# it as the "x-internal-key" header. Generate a long random value, e.g.:
#   openssl rand -hex 32
INTERNAL_API_KEY=

# ── SMS delivery (Termii) ────────────────────────────────────────────────────
# Transactional SMS receipts (purchase confirmations, wallet credits). When the
# API key is absent SMS is silently skipped — email + in-app notifications keep
# working. Sender ID must be an approved Termii sender (defaults to TopFlowNG).
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=TopFlowNG
TERMII_BASE_URL=https://api.ng.termii.com/api/sms/send
TERMII_TIMEOUT_MS=15000

# ── Paystack tuning ──────────────────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_API_BASE_URL=https://api.paystack.co
PAYSTACK_TIMEOUT_MS=30000

# ── Observability ─────────────────────────────────────────────────────────────
# Structured log level: debug | info | warn | error.
LOG_LEVEL=info

# ── AI assistant (OpenRouter) ────────────────────────────────────────────────
# Server-only AI key. NEVER expose to the frontend. AI is read-only/advisory.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_FALLBACK_MODEL=hermes
# Optional comma-separated extra models allowed at /api/ai/chat.
AI_MODEL_ALLOWLIST=
OPENROUTER_APP_URL=https://topflowng.com
OPENROUTER_APP_NAME=TopFlowNG
AI_TIMEOUT_MS=30000
AI_MAX_INPUT_LENGTH=2000
AI_MAX_OUTPUT_TOKENS=1024
# Per-user AI rate limit: window (ms) and max requests per window.
AI_RATE_WINDOW_MS=3600000
AI_RATE_MAX=20
# Optional daily global ceilings: requests and max $ cost (0 = unlimited).
AI_DAILY_REQUEST_CEILING=1000
AI_DAILY_COST_CEILING=0

# ── Tests only (no secrets required, never set in production) ────────────────
# The test suite boots against dedicated throwaway PostgreSQL databases and
# never touches a real one. Defaults match a local postgres with `trust` auth.
PG_HOST=127.0.0.1
PG_PORT=55432
PG_USER=postgres
PG_PASSWORD=
# Control DB used to CREATE/DROP throwaway test databases.
PG_ADMIN_DB=postgres
# 1 when installing deps without fetching the Playwright browser binaries.
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=0
